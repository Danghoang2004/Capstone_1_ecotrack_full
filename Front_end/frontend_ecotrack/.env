# API Base URL
# Thay đổi URL này theo môi trường của bạn
# Local: http://127.0.0.1:8080
# Production: https://your-api-domain.com
API_BASE_URL=http://172.25.3.44:8080

# Optional: Third-party map tiles
# If GOONG_MAP_KEY is provided, app will use Goong tiles by default.
# If MAP_TILE_URL_TEMPLATE is provided, it will override default tile source.
# You can use {api_key} placeholder in MAP_TILE_URL_TEMPLATE.
# Example:
# MAP_TILE_URL_TEMPLATE=https://tiles.goong.io/tile/{z}/{x}/{y}.png?api_key={api_key}
GOONG_MAP_KEY=
MAP_TILE_URL_TEMPLATE=
