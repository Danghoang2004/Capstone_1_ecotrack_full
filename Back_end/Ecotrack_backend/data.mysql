-- ================================================================
-- PARTNERS
-- ================================================================
CREATE TABLE partners (
    partner_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT UNIQUE NOT NULL,
    company_name VARCHAR(200) NOT NULL,
    website VARCHAR(200),
    logo_url VARCHAR(255),
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- ================================================================
-- COUPONS (Hoàn chỉnh DB2)
-- ================================================================
CREATE TABLE coupons (
    coupon_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    partner_id BIGINT NOT NULL,
    code VARCHAR(50) NOT NULL,
    description TEXT,
    discount_type ENUM('PERCENT','FIXED') NOT NULL,
    discount_value DOUBLE NOT NULL,
    usage_limit INT NOT NULL,
    used_count INT NOT NULL DEFAULT 0,
    expiry_date DATE NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,

    badge_label VARCHAR(50),
    category VARCHAR(50),
    final_price DOUBLE,
    location_scope VARCHAR(50),
    location_text VARCHAR(255),
    max_redeem_per_user INT,
    original_price DOUBLE,
    required_points INT,
    short_description VARCHAR(500),
    start_date DATE,
    thumbnail_url VARCHAR(255),
    title VARCHAR(255),

    FOREIGN KEY (partner_id) REFERENCES partners(partner_id) ON DELETE CASCADE,

    INDEX idx_partner_id (partner_id),
    INDEX idx_code (code),
    INDEX idx_expiry_date (expiry_date),
    UNIQUE INDEX uq_code (code)
);

CREATE TABLE user_coupons (
    user_coupon_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT NOT NULL,
    coupon_id BIGINT NOT NULL,
    status ENUM('UNUSED','USED','EXPIRED') NOT NULL DEFAULT 'UNUSED',
    used_at DATETIME NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,
    FOREIGN KEY ( coupon_id) REFERENCES coupons ( coupon_id) ON DELETE RESTRICT
);

-- ================================================================
-- CAMPAIGNS
-- ================================================================
CREATE TABLE campaigns (
    campaign_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    created_by_partner_id BIGINT,
    title VARCHAR(200) NOT NULL,
    description TEXT,
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,
    start_time TIME,
    end_time TIME,
    location_address VARCHAR(255) NOT NULL,
    max_participants INT,
    image_url VARCHAR(255),
    reward_points INT DEFAULT 0,
    qr_code_url VARCHAR(255),
    FOREIGN KEY (created_by_partner_id) REFERENCES partners(partner_id) ON DELETE SET NULL
);

CREATE TABLE campaign_participants (
    campaign_id BIGINT NOT NULL,
    user_id BIGINT NOT NULL,
    joined_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (campaign_id, user_id),
    FOREIGN KEY (campaign_id) REFERENCES campaigns(campaign_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

CREATE TABLE campaign_badge_rewards (
    campaign_id BIGINT NOT NULL,
    badge_id BIGINT NOT NULL,
    PRIMARY KEY (campaign_id, badge_id),
    FOREIGN KEY (campaign_id) REFERENCES campaigns(campaign_id) ON DELETE CASCADE,
    FOREIGN KEY (badge_id) REFERENCES badges(badge_id) ON DELETE CASCADE
);

CREATE TABLE checkins (
    checkin_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    campaign_id BIGINT NOT NULL,
    user_id BIGINT NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (campaign_id) REFERENCES campaigns(campaign_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

CREATE TABLE campaign_likes (
    campaign_like_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    campaign_id BIGINT NOT NULL,
    user_id BIGINT NOT NULL,
    UNIQUE KEY uk_campaign_user_like (campaign_id, user_id),
    FOREIGN KEY (campaign_id) REFERENCES campaigns(campaign_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

CREATE TABLE campaign_comments (
    comment_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    campaign_id BIGINT NOT NULL,
    user_id BIGINT NOT NULL,
    content TEXT NOT NULL,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (campaign_id) REFERENCES campaigns(campaign_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- ================================================================
-- NOTIFICATIONS
-- ================================================================
CREATE TABLE notifications (
    notification_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT,
    source_scope ENUM('USER_EVENT','ADMIN_BROADCAST_MASTER','ADMIN_BROADCAST_DELIVERY') NOT NULL DEFAULT 'USER_EVENT',
    created_by_user_id BIGINT,
    notification_type ENUM('CAMPAIGN','ACHIEVEMENT','REWARD','SYSTEM') NOT NULL,
    title VARCHAR(255) NOT NULL,
    message TEXT NOT NULL,
    is_read BOOLEAN NOT NULL DEFAULT FALSE,
    target_type VARCHAR(50),
    target_id BIGINT,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,
    FOREIGN KEY (created_by_user_id) REFERENCES users(user_id) ON DELETE SET NULL,
    INDEX idx_notifications_source_scope_created_at (source_scope, created_at),
    INDEX idx_notifications_user_scope_created_at (user_id, source_scope, created_at)
);

CREATE TABLE user_broadcast_read_state (
    user_id BIGINT PRIMARY KEY,
    last_read_master_notification_id BIGINT NULL,
    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,
    FOREIGN KEY (last_read_master_notification_id) REFERENCES notifications(notification_id) ON DELETE SET NULL,
    INDEX idx_ubrs_last_read_master (last_read_master_notification_id)
);

-- ================================================================
-- ACTIVITY_LOGS
-- ================================================================
CREATE TABLE activity_logs (
    log_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT NOT NULL,
    action VARCHAR(100) NOT NULL,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- ================================================================
-- DỮ LIỆU MẪU
-- ================================================================
