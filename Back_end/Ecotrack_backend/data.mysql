-- 1) roles: thêm 17 role để tổng role hiện có là 20
INSERT IGNORE INTO roles (role_name)
SELECT CONCAT('ROLE_EXTRA_', LPAD(n, 2, '0'))
FROM tmp_seed20
WHERE n <= 17;

-- 1.1) users: thêm tài khoản team lead môi trường mẫu
INSERT IGNORE INTO users
(
    username, password, email,
    account_non_expired, is_enabled, account_non_locked, credentials_non_expired,
    provider_id, is_verified, verification_code, last_credentials_update
)
VALUES
(
    'env_lead_01',
    '$2a$10$gSiGn10kvbT96EdP.Sz8UuKzSrXzx6Ph2VLirfIa3doSfGTt73vRy',
    'env_lead_01@gmail.com',
    TRUE, TRUE, TRUE, TRUE,
    NULL, TRUE, NULL, NULL
);

-- 1.2) user_role: gán ROLE_ENVIRONMENT cho tài khoản team lead môi trường
INSERT IGNORE INTO user_role (user_id, role_id)
SELECT u.user_id, r.role_id
FROM users u
JOIN roles r ON r.role_name = 'ROLE_ENVIRONMENT'
WHERE u.username = 'env_lead_01';

-- 2) users: 20 dòng
INSERT IGNORE INTO users
(
    username, password, email,
    account_non_expired, is_enabled, account_non_locked, credentials_non_expired,
    provider_id, is_verified, verification_code, last_credentials_update
)
SELECT
    CONCAT('dn_user_', LPAD(n, 2, '0')),
    '$2a$10$gSiGn10kvbT96EdP.Sz8UuKzSrXzx6Ph2VLirfIa3doSfGTt73vRy',
    CONCAT('dn_user_', LPAD(n, 2, '0'), '@gmail.com'),
    TRUE, TRUE, TRUE, TRUE,
    NULL,
    CASE WHEN MOD(n, 2) = 0 THEN TRUE ELSE FALSE END,
    CASE WHEN MOD(n, 2) = 0 THEN NULL ELSE CONCAT('VERIFY_DN_', LPAD(n, 2, '0')) END,
    DATE_SUB(NOW(), INTERVAL n DAY)
FROM tmp_seed20;

-- 3) user_role: 20 dòng
INSERT IGNORE INTO user_role (user_id, role_id)
SELECT
    u.user_id,
    r.role_id
FROM tmp_seed20 s
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'))
JOIN roles r ON r.role_name = CASE
    WHEN s.n <= 14 THEN 'ROLE_USER'
    WHEN s.n <= 18 THEN 'ROLE_PARTNER'
    ELSE 'ROLE_ADMIN'
END;

-- 3.1) user_role: bổ sung tài khoản môi trường mẫu để test team/member
INSERT IGNORE INTO user_role (user_id, role_id)
SELECT u.user_id, r.role_id
FROM users u
JOIN roles r ON r.role_name = 'ROLE_ENVIRONMENT'
WHERE u.username IN ('dn_user_01', 'dn_user_02', 'dn_user_03', 'dn_user_04', 'dn_user_05');

-- 4) levels: 20 dòng
INSERT INTO levels (level_name, min_points, max_points, icon_url)
SELECT
    CONCAT('Level ', LPAD(n, 2, '0')),
    (n - 1) * 100,
    (n * 100) - 1,
    CONCAT('icons/level_', LPAD(n, 2, '0'), '.png')
FROM tmp_seed20;

-- 5) user_profiles: 20 dòng
INSERT IGNORE INTO user_profiles
(
    user_id, full_name, avatar_url, gender,
    phone_number, birth_date, location, level_id,
    quiz_streak, last_quiz_date
)
SELECT
    u.user_id,
    CONCAT('Nguoi dung Da Nang ', LPAD(s.n, 2, '0')),
    CONCAT('avatars/dn_user_', LPAD(s.n, 2, '0'), '.png'),
    CASE MOD(s.n, 3)
        WHEN 1 THEN 'M'
        WHEN 2 THEN 'F'
        ELSE 'O'
    END,
    CONCAT('0901', LPAD(s.n, 6, '0')),
    DATE_SUB('2004-12-31', INTERVAL s.n * 250 DAY),
    'Da Nang, Viet Nam',
    l.level_id,
    MOD(s.n, 7),
    DATE_SUB(CURDATE(), INTERVAL s.n DAY)
FROM tmp_seed20 s
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'))
JOIN levels l ON l.level_name = CONCAT('Level ', LPAD(s.n, 2, '0'));

-- 6) user_points: 20 dòng
INSERT IGNORE INTO user_points (user_id, points)
SELECT
    u.user_id,
    s.n * 120
FROM tmp_seed20 s
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'));

-- 7) point_transactions: 20 dòng
INSERT INTO point_transactions (user_id, action_type, points, description, created_at)
SELECT
    u.user_id,
    CASE MOD(s.n, 6)
        WHEN 1 THEN 'REPORT'
        WHEN 2 THEN 'CAMPAIGN'
        WHEN 3 THEN 'BADGE'
        WHEN 4 THEN 'QUIZ'
        WHEN 5 THEN 'VOUCHER'
        ELSE 'OTHER'
    END,
    CASE WHEN MOD(s.n, 5) = 0 THEN -50 ELSE 20 + s.n END,
    CONCAT('Giao dich diem #', LPAD(s.n, 2, '0')),
    DATE_SUB(NOW(), INTERVAL s.n HOUR)
FROM tmp_seed20 s
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'));

-- 8) badges: 20 dòng
INSERT INTO badges (badge_name, icon_url, description, requirement)
SELECT
    CONCAT('Huy hieu ', LPAD(n, 2, '0')),
    CONCAT('badges/badge_', LPAD(n, 2, '0'), '.png'),
    CONCAT('Mo ta huy hieu so ', n),
    CONCAT('Yeu cau dat moc ', n * 50, ' diem')
FROM tmp_seed20;

-- 9) user_badges: 20 dòng
INSERT IGNORE INTO user_badges (user_id, badge_id, awarded_at)
SELECT
    u.user_id,
    b.badge_id,
    DATE_SUB(NOW(), INTERVAL s.n DAY)
FROM tmp_seed20 s
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'))
JOIN badges b ON b.badge_name = CONCAT('Huy hieu ', LPAD(s.n, 2, '0'));

-- 10) leaderboard: 20 dòng
INSERT INTO leaderboard (user_id, rank_position, score, snapshot_date, updated_at)
SELECT
    u.user_id,
    s.n,
    (21 - s.n) * 150,
    CURDATE(),
    NOW()
FROM tmp_seed20 s
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'));

-- 11) community_groups: 20 dòng
INSERT INTO community_groups (group_name, created_by_user_id)
SELECT
    CONCAT('Nhom cong dong Da Nang ', LPAD(s.n, 2, '0')),
    u.user_id
FROM tmp_seed20 s
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'));

-- 12) group_members: 20 dòng
INSERT IGNORE INTO group_members (group_id, user_id, role)
SELECT
    g.group_id,
    u.user_id,
    'ADMIN'
FROM tmp_seed20 s
JOIN community_groups g ON g.group_name = CONCAT('Nhom cong dong Da Nang ', LPAD(s.n, 2, '0'))
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'));

-- 13) group_leaderboard: 20 dòng
INSERT INTO group_leaderboard (group_id, total_score, snapshot_date, updated_at)
SELECT
    g.group_id,
    1000 + (s.n * 80),
    CURDATE(),
    NOW()
FROM tmp_seed20 s
JOIN community_groups g ON g.group_name = CONCAT('Nhom cong dong Da Nang ', LPAD(s.n, 2, '0'));

-- 14) quizzes: 20 dòng
INSERT INTO quizzes (title, points_reward, status)
SELECT
    CONCAT('Quiz Moi Truong Da Nang ', LPAD(n, 2, '0')),
    10 + n,
    'PUBLISHED'
FROM tmp_seed20;

-- 15) quiz_questions: 20 dòng
INSERT INTO quiz_questions
(
    quiz_id, question_text,
    option_a, option_b, option_c, option_d,
    correct_option
)
SELECT
    q.quiz_id,
    CONCAT('Cau hoi quiz so ', s.n, ': Phan loai rac dung cach?'),
    'Vo chai nhua',
    'La cay va thuc an thua',
    'Pin da qua su dung',
    'Rac xay dung',
    'B'
FROM tmp_seed20 s
JOIN quizzes q ON q.title = CONCAT('Quiz Moi Truong Da Nang ', LPAD(s.n, 2, '0'));

-- 16) user_quiz_attempts: 20 dòng
INSERT INTO user_quiz_attempts (user_id, quiz_id, score, completed_at)
SELECT
    u.user_id,
    q.quiz_id,
    5 + MOD(s.n, 6),
    DATE_SUB(NOW(), INTERVAL s.n DAY)
FROM tmp_seed20 s
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'))
JOIN quizzes q ON q.title = CONCAT('Quiz Moi Truong Da Nang ', LPAD(s.n, 2, '0'));

