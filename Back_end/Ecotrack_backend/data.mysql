-- 18) report_verifications: 20 dòng cho dữ liệu mới
INSERT INTO report_verifications (report_id, verified_by, result, confidence_score, created_at)
SELECT
    wr.report_id,
    u.user_id,
    CASE MOD(s.n, 2)
        WHEN 0 THEN 'APPROVED'
        ELSE 'REJECTED'
    END,
    CASE MOD(s.n, 2)
        WHEN 0 THEN 92.40
        ELSE 67.80
    END,
    DATE_SUB(NOW(), INTERVAL s.n MINUTE)
FROM tmp_seed20 s
JOIN waste_reports wr ON wr.title = CASE s.n
    WHEN 1 THEN 'Bao cao rac Thanh Khe 01'
    WHEN 2 THEN 'Bao cao rac Hai Chau 02'
    WHEN 3 THEN 'Bao cao rac Hoa Xuan 03'
    WHEN 4 THEN 'Bao cao rac Hoa Khanh 04'
    WHEN 5 THEN 'Bao cao rac Hoa Cuong 05'
    WHEN 6 THEN 'Bao cao rac Vinh Trung 06'
    WHEN 7 THEN 'Bao cao rac Hoa An 07'
    WHEN 8 THEN 'Bao cao rac An Khe 08'
    WHEN 9 THEN 'Bao cao rac Hoa Minh 09'
    WHEN 10 THEN 'Bao cao rac Khu Trung 10'
    WHEN 11 THEN 'Bao cao rac Chinh Gian 11'
    WHEN 12 THEN 'Bao cao rac Nam Duong 12'
    WHEN 13 THEN 'Bao cao rac Hoa Tho 13'
    WHEN 14 THEN 'Bao cao rac Ha Mau 14'
    WHEN 15 THEN 'Bao cao rac Xuan Ha 15'
    WHEN 16 THEN 'Bao cao rac Hoa Phat 16'
    WHEN 17 THEN 'Bao cao rac Khu Trung 17'
    WHEN 18 THEN 'Bao cao rac Hoa Khanh Nam 18'
    WHEN 19 THEN 'Bao cao rac Trung Nuoc 19'
    ELSE 'Bao cao rac Hoa Cam 20'
END
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'));

-- 19) partners: 20 dòng
INSERT IGNORE INTO partners (user_id, company_name, website, logo_url)
SELECT
    u.user_id,
    CONCAT('Doi tac Da Nang ', LPAD(s.n, 2, '0')),
    CONCAT('https://doitac-danang-', LPAD(s.n, 2, '0'), '.vn'),
    CONCAT('logos/partners/danang_partner_', LPAD(s.n, 2, '0'), '.png')
FROM tmp_seed20 s
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'));

-- 20) coupons: 20 dòng
INSERT IGNORE INTO coupons
(
    partner_id, code, description, discount_type, discount_value,
    usage_limit, used_count, expiry_date, is_active, created_at,
    badge_label, category, final_price, location_scope, location_text,
    max_redeem_per_user, original_price, required_points,
    short_description, start_date, thumbnail_url, title
)
SELECT
    p.partner_id,
    CONCAT('DNG2026', LPAD(s.n, 3, '0')),
    CONCAT('Uu dai xanh Da Nang #', s.n),
    CASE WHEN MOD(s.n, 2) = 0 THEN 'PERCENT' ELSE 'FIXED' END,
    CASE WHEN MOD(s.n, 2) = 0 THEN 12 ELSE 25000 END,
    200,
    0,
    DATE_ADD(CURDATE(), INTERVAL 90 DAY),
    TRUE,
    NOW(),
    'ECO',
    CASE WHEN s.n <= 10 THEN 'Food' ELSE 'Lifestyle' END,
    CASE WHEN MOD(s.n, 2) = 0 THEN 88000 ELSE 75000 END,
    'CITY',
    'Da Nang',
    2,
    100000,
    100 + (s.n * 10),
    CONCAT('Voucher ap dung tai Da Nang, ma so ', s.n),
    CURDATE(),
    CONCAT('coupons/danang_', LPAD(s.n, 3, '0'), '.png'),
    CONCAT('Voucher Da Nang ', LPAD(s.n, 2, '0'))
FROM tmp_seed20 s
JOIN partners p ON p.company_name = CONCAT('Doi tac Da Nang ', LPAD(s.n, 2, '0'));

-- 21) user_coupons: 20 dòng
INSERT INTO user_coupons (user_id, coupon_id, status, used_at, created_at)
SELECT
    u.user_id,
    c.coupon_id,
    CASE
        WHEN MOD(s.n, 4) = 0 THEN 'EXPIRED'
        WHEN MOD(s.n, 3) = 0 THEN 'USED'
        ELSE 'UNUSED'
    END,
    CASE WHEN MOD(s.n, 3) = 0 THEN DATE_SUB(NOW(), INTERVAL s.n DAY) ELSE NULL END,
    DATE_SUB(NOW(), INTERVAL s.n DAY)
FROM tmp_seed20 s
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'))
JOIN coupons c ON c.code = CONCAT('DNG2026', LPAD(s.n, 3, '0'));

-- 22) campaigns: 20 dòng
INSERT INTO campaigns
(
    created_by_partner_id, title, description,
    start_date, end_date, start_time, end_time,
    location_address, max_participants,
    image_url, reward_points, qr_code_url
)
SELECT
    p.partner_id,
    CONCAT('Chien dich xanh Da Nang ', LPAD(s.n, 2, '0')),
    CONCAT('Hoat dong don dep moi truong tai Da Nang dot ', s.n),
    DATE_ADD(CURDATE(), INTERVAL s.n DAY),
    DATE_ADD(CURDATE(), INTERVAL s.n + 1 DAY),
    '06:30:00',
    '10:30:00',
    CONCAT('Khu vuc cong cong Da Nang so ', s.n),
    50 + (s.n * 5),
    CONCAT('campaigns/danang_campaign_', LPAD(s.n, 2, '0'), '.jpg'),
    30 + (s.n * 3),
    CONCAT('campaign_qrs/danang_qr_', LPAD(s.n, 2, '0'), '.png')
FROM tmp_seed20 s
JOIN partners p ON p.company_name = CONCAT('Doi tac Da Nang ', LPAD(s.n, 2, '0'));

-- 23) campaign_participants: 20 dòng
INSERT IGNORE INTO campaign_participants (campaign_id, user_id, joined_at)
SELECT
    c.campaign_id,
    u.user_id,
    DATE_SUB(NOW(), INTERVAL s.n DAY)
FROM tmp_seed20 s
JOIN campaigns c ON c.title = CONCAT('Chien dich xanh Da Nang ', LPAD(s.n, 2, '0'))
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'));

-- 24) campaign_badge_rewards: 20 dòng
INSERT IGNORE INTO campaign_badge_rewards (campaign_id, badge_id)
SELECT
    c.campaign_id,
    b.badge_id
FROM tmp_seed20 s
JOIN campaigns c ON c.title = CONCAT('Chien dich xanh Da Nang ', LPAD(s.n, 2, '0'))
JOIN badges b ON b.badge_name = CONCAT('Huy hieu ', LPAD(s.n, 2, '0'));

-- 25) checkins: 20 dòng
INSERT INTO checkins (campaign_id, user_id, created_at)
SELECT
    c.campaign_id,
    u.user_id,
    DATE_SUB(NOW(), INTERVAL s.n HOUR)
FROM tmp_seed20 s
JOIN campaigns c ON c.title = CONCAT('Chien dich xanh Da Nang ', LPAD(s.n, 2, '0'))
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'));

-- 26) campaign_likes: 20 dòng
INSERT IGNORE INTO campaign_likes (campaign_id, user_id)
SELECT
    c.campaign_id,
    u.user_id
FROM tmp_seed20 s
JOIN campaigns c ON c.title = CONCAT('Chien dich xanh Da Nang ', LPAD(s.n, 2, '0'))
JOIN users u ON u.username = CONCAT('dn_user_', LPAD((21 - s.n), 2, '0'));

-- 27) campaign_comments: 20 dòng
INSERT INTO campaign_comments (campaign_id, user_id, content, created_at)
SELECT
    c.campaign_id,
    u.user_id,
    CONCAT('Binh luan dong gop cho chien dich so ', s.n, ' tai Da Nang.'),
    DATE_SUB(NOW(), INTERVAL s.n HOUR)
FROM tmp_seed20 s
JOIN campaigns c ON c.title = CONCAT('Chien dich xanh Da Nang ', LPAD(s.n, 2, '0'))
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'));

-- 28) notifications: 20 dòng
INSERT INTO notifications
(
    user_id, source_scope, created_by_user_id, notification_type, title, message,
    is_read, target_type, target_id, created_at
)
SELECT
    u.user_id,
    'USER_EVENT',
    NULL,
    CASE MOD(s.n, 4)
        WHEN 1 THEN 'CAMPAIGN'
        WHEN 2 THEN 'ACHIEVEMENT'
        WHEN 3 THEN 'REWARD'
        ELSE 'SYSTEM'
    END,
    CONCAT('Thong bao #', LPAD(s.n, 2, '0')),
    CONCAT('Noi dung thong bao he thong cho nguoi dung ', s.n),
    CASE WHEN MOD(s.n, 2) = 0 THEN TRUE ELSE FALSE END,
    'USER',
    u.user_id,
    DATE_SUB(NOW(), INTERVAL s.n HOUR)
FROM tmp_seed20 s
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'));

-- 29) activity_logs: 20 dòng
INSERT INTO activity_logs (user_id, action, created_at)
SELECT
    u.user_id,
    CASE MOD(s.n, 5)
        WHEN 1 THEN 'CREATE_REPORT'
        WHEN 2 THEN 'JOIN_CAMPAIGN'
        WHEN 3 THEN 'COMPLETE_QUIZ'
        WHEN 4 THEN 'REDEEM_COUPON'
        ELSE 'UPDATE_PROFILE'
    END,
    DATE_SUB(NOW(), INTERVAL s.n MINUTE)
FROM tmp_seed20 s
JOIN users u ON u.username = CONCAT('dn_user_', LPAD(s.n, 2, '0'));

