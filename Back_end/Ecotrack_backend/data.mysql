SELECT suggestion_id, 3, 'Lắp nến', 'Đặt nến tealight vào trong lon và kiểm tra an toàn.', 'https://images.unsplash.com/photo-1515444744559-5f6b18f5ddc0', NULL
FROM recycle_suggestions WHERE title = 'Đèn nến từ lon nước';

