SELECT suggestion_id, 1, 'Làm sạch lon', 'Rửa sạch lon kim loại và bóc nhãn cũ.', 'https://images.unsplash.com/photo-1532634896-26909d0d4b6b', NULL
FROM recycle_suggestions WHERE title = 'Đèn nến từ lon nước';
