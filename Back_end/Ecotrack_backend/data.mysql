-- Tạo database
CREATE DATABASE IF NOT EXISTS ecotrack_demo1 CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE ecotrack_demo1;

-- ================================================================
-- ROLES
-- ================================================================
CREATE TABLE roles (
    role_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    role_name VARCHAR(50) NOT NULL UNIQUE
);

-- ================================================================
-- USERS
-- ================================================================
CREATE TABLE users (
    user_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(100) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    email VARCHAR(100) NOT NULL,
    account_non_expired BOOLEAN DEFAULT TRUE,
    is_enabled BOOLEAN DEFAULT TRUE,
    account_non_locked BOOLEAN DEFAULT TRUE,
    credentials_non_expired BOOLEAN DEFAULT TRUE,
    provider_id VARCHAR(255),
    is_verified BOOLEAN DEFAULT FALSE,
    verification_code VARCHAR(255),
    last_credentials_update DATETIME NULL
);

-- ================================================================
-- USER_ROLE
-- ================================================================
CREATE TABLE user_role (
    user_id BIGINT NOT NULL,
    role_id BIGINT NOT NULL,
    PRIMARY KEY (user_id, role_id),
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,
    FOREIGN KEY (role_id) REFERENCES roles(role_id) ON DELETE CASCADE
);

-- ================================================================
-- LEVELS
-- ================================================================
CREATE TABLE levels (
    level_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    level_name VARCHAR(100) NOT NULL,
    min_points INT NOT NULL,
    max_points INT NOT NULL,
    icon_url VARCHAR(255)
);

-- ================================================================
-- USER_PROFILES
-- ================================================================
CREATE TABLE user_profiles (
    profile_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT UNIQUE NOT NULL,
    full_name VARCHAR(100),
    avatar_url VARCHAR(255) NOT NULL DEFAULT 'default_avatar.png',
    gender ENUM('M','F','O'),
   phone_number VARCHAR(20) NULL ,
    birth_date DATE,
    location VARCHAR(150),
    level_id BIGINT,
    quiz_streak INT NOT NULL DEFAULT 0,
    last_quiz_date DATE NULL,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,
    FOREIGN KEY (level_id) REFERENCES levels(level_id) ON DELETE SET NULL
);

-- ================================================================
-- USER_POINTS
-- ================================================================
CREATE TABLE user_points (
    user_id BIGINT PRIMARY KEY,
    points INT NOT NULL DEFAULT 0,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- ================================================================
-- POINT_TRANSACTIONS
-- ================================================================
CREATE TABLE point_transactions (
    transaction_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT NOT NULL,
    action_type ENUM('REPORT','CAMPAIGN','BADGE','QUIZ','VOUCHER','OTHER') NOT NULL,
    points INT NOT NULL,
    description VARCHAR(255),
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- ================================================================
-- BADGES
-- ================================================================
CREATE TABLE badges (
    badge_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    badge_name VARCHAR(100) NOT NULL,
    icon_url VARCHAR(255) NOT NULL,
    description TEXT,
    requirement TEXT
);

-- ================================================================
-- USER_BADGES
-- ================================================================
CREATE TABLE user_badges (
    user_id BIGINT NOT NULL,
    badge_id BIGINT NOT NULL,
    awarded_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (user_id, badge_id),
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,
    FOREIGN KEY (badge_id) REFERENCES badges(badge_id) ON DELETE CASCADE
);

-- ================================================================
-- LEADERBOARD
-- ================================================================
CREATE TABLE leaderboard (
    leaderboard_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT NOT NULL,
    rank_position INT NOT NULL,
    score INT NOT NULL,
    snapshot_date DATE NOT NULL,
    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- ================================================================
-- COMMUNITY_GROUPS
-- ================================================================
CREATE TABLE community_groups (
    group_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    group_name VARCHAR(150) NOT NULL,
    created_by_user_id BIGINT,
    FOREIGN KEY (created_by_user_id) REFERENCES users(user_id) ON DELETE SET NULL
);

-- ================================================================
-- GROUP_MEMBERS
-- ================================================================
CREATE TABLE group_members (
    group_id BIGINT NOT NULL,
    user_id BIGINT NOT NULL,
    role ENUM('ADMIN','MEMBER') NOT NULL DEFAULT 'MEMBER',
    PRIMARY KEY (group_id, user_id),
    FOREIGN KEY (group_id) REFERENCES community_groups(group_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- ================================================================
-- GROUP_LEADERBOARD
-- ================================================================
CREATE TABLE group_leaderboard (
    group_leaderboard_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    group_id BIGINT NOT NULL,
    total_score INT NOT NULL DEFAULT 0,
    snapshot_date DATE NOT NULL,
    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (group_id) REFERENCES community_groups(group_id) ON DELETE CASCADE
);

-- ================================================================
-- QUIZZES
-- ================================================================
CREATE TABLE quizzes (
    quiz_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    points_reward INT NOT NULL DEFAULT 0,
    status ENUM('DRAFT','PUBLISHED') NOT NULL DEFAULT 'DRAFT'
);

CREATE TABLE quiz_questions (
    question_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    quiz_id BIGINT NOT NULL,
    question_text TEXT NOT NULL,
    option_a TEXT NOT NULL,
    option_b TEXT NOT NULL,
    option_c TEXT NOT NULL,
    option_d TEXT NOT NULL,
    correct_option ENUM('A','B','C','D') NOT NULL,
    FOREIGN KEY (quiz_id) REFERENCES quizzes(quiz_id) ON DELETE CASCADE
);

CREATE TABLE user_quiz_attempts (
    attempt_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT NOT NULL,
    quiz_id BIGINT NOT NULL,
    score INT NOT NULL,
    completed_at DATETIME NOT NULL,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,
    FOREIGN KEY (quiz_id) REFERENCES quizzes(quiz_id) ON DELETE RESTRICT
);

-- ================================================================
-- WASTE_REPORTS
-- ================================================================
CREATE TABLE waste_reports (
    report_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT,
    title VARCHAR(200) NOT NULL,
    description TEXT,
    image_url VARCHAR(255) NOT NULL,
    gps_lat DECIMAL(10,8) NOT NULL,
    gps_long DECIMAL(11,8) NOT NULL,
    status ENUM('PENDING','VERIFIED','REJECTED','CLEANED') NOT NULL DEFAULT 'PENDING',
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    category VARCHAR(50),
   ai_verified TINYINT(1) NULL DEFAULT NULL,
   ai_confidence DOUBLE NULL DEFAULT '0',
   ai_analysis_json TEXT NULL DEFAULT NULL COLLATE 'utf8mb4_unicode_ci',
   ai_analyzed_image_url  VARCHAR(255) NULL DEFAULT NULL COLLATE 'utf8mb4_unicode_ci',
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE SET NULL
);

CREATE TABLE report_verifications (
    verification_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    report_id BIGINT NOT NULL,
    verified_by BIGINT,
    result ENUM('APPROVED','REJECTED') NOT NULL,
    confidence_score DECIMAL(5,2) NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (report_id) REFERENCES waste_reports(report_id) ON DELETE CASCADE,
    FOREIGN KEY (verified_by) REFERENCES users(user_id) ON DELETE SET NULL
);

-- ================================================================
-- ENVIRONMENT_CLEANUP_TASKS
-- ================================================================
CREATE TABLE environment_cleanup_tasks (
    task_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    report_id BIGINT NOT NULL,
    team_lead_user_id BIGINT NOT NULL,
    status ENUM('ASSIGNED','CLEANED_PENDING_CONFIRM','RESOLVED') NOT NULL DEFAULT 'ASSIGNED',
    assignment_note TEXT NULL,
    planned_start_at DATETIME NULL,
    planned_end_at DATETIME NULL,
    due_at DATETIME NULL,
    assigned_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    completed_note TEXT NULL,
    after_image_url VARCHAR(500) NULL,
    completed_gps_lat DECIMAL(10,6) NULL,
    completed_gps_long DECIMAL(10,6) NULL,
    completed_at DATETIME NULL,
    resolved_by_admin_id BIGINT NULL,
    resolved_at DATETIME NULL,
    FOREIGN KEY (report_id) REFERENCES waste_reports(report_id) ON DELETE CASCADE,
    FOREIGN KEY (team_lead_user_id) REFERENCES users(user_id) ON DELETE RESTRICT,
    FOREIGN KEY (resolved_by_admin_id) REFERENCES users(user_id) ON DELETE SET NULL,
    INDEX idx_env_tasks_team_status (team_lead_user_id, status),
    INDEX idx_env_tasks_report (report_id)
);

CREATE TABLE environment_teams (
    team_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    team_name VARCHAR(150) NOT NULL,
    description TEXT NULL,
    is_active TINYINT(1) NOT NULL DEFAULT 1,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    UNIQUE KEY uk_environment_teams_team_name (team_name)
);

CREATE TABLE environment_team_members (
    team_member_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    team_id BIGINT NOT NULL,
    user_id BIGINT NOT NULL,
    role ENUM('LEAD','MEMBER') NOT NULL DEFAULT 'MEMBER',
    is_active TINYINT(1) NOT NULL DEFAULT 1,
    joined_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    removed_at DATETIME NULL,
    FOREIGN KEY (team_id) REFERENCES environment_teams(team_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE RESTRICT,
    UNIQUE KEY uk_environment_team_user (team_id, user_id),
    INDEX idx_environment_team_members_user_active (user_id, is_active),
    INDEX idx_environment_team_members_team_role (team_id, role)
);

CREATE TABLE environment_team_kpi_daily (
    kpi_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    team_id BIGINT NOT NULL,
    kpi_date DATE NOT NULL,
    total_assigned INT NOT NULL DEFAULT 0,
    total_completed_pending INT NOT NULL DEFAULT 0,
    total_resolved INT NOT NULL DEFAULT 0,
    completion_rate DECIMAL(5,2) NOT NULL DEFAULT 0.00,
    avg_resolution_minutes INT NULL,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (team_id) REFERENCES environment_teams(team_id) ON DELETE CASCADE,
    UNIQUE KEY uk_environment_team_kpi_daily (team_id, kpi_date),
    INDEX idx_environment_team_kpi_daily_date (kpi_date)
);

CREATE TABLE environment_team_chat_messages (
    message_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    team_id BIGINT NOT NULL,
    sender_user_id BIGINT NOT NULL,
    message_text TEXT NOT NULL,
    message_type VARCHAR(20) NOT NULL DEFAULT 'TEXT',
    attachment_url VARCHAR(1000) NULL,
    attachment_name VARCHAR(255) NULL,
    attachment_mime_type VARCHAR(120) NULL,
    attachment_size_bytes BIGINT NULL,
    sent_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (team_id) REFERENCES environment_teams(team_id) ON DELETE CASCADE,
    FOREIGN KEY (sender_user_id) REFERENCES users(user_id) ON DELETE RESTRICT,
    INDEX idx_env_team_chat_team_sent (team_id, sent_at),
    INDEX idx_env_team_chat_team_msg (team_id, message_id)
);

CREATE TABLE environment_team_chat_read_state (
    read_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    team_id BIGINT NOT NULL,
    user_id BIGINT NOT NULL,
    last_read_message_id BIGINT NOT NULL DEFAULT 0,
    last_seen_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (team_id) REFERENCES environment_teams(team_id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,
    UNIQUE KEY uk_env_team_chat_read_team_user (team_id, user_id),
    INDEX idx_env_team_chat_read_team_msg (team_id, last_read_message_id)
);

-- ================================================================
-- AI_WASTE_CLASSIFICATION_HISTORY
-- ================================================================
CREATE TABLE ai_waste_classification_history (
    history_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    user_id BIGINT NULL,
    trash_detected BOOLEAN NOT NULL DEFAULT FALSE,
    overall_confidence DOUBLE NOT NULL DEFAULT 0,
    total_objects_detected INT NOT NULL DEFAULT 0,
    waste_types_json LONGTEXT NULL,
    detections_json LONGTEXT NULL,
    raw_result_json LONGTEXT NULL,
    original_image_url VARCHAR(500) NULL,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE SET NULL,
    INDEX idx_ai_history_user_created_at (user_id, created_at)
);

-- ================================================================
-- RECYCLE_SUGGESTIONS
-- ================================================================
CREATE TABLE recycle_suggestions (
    suggestion_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    waste_type_key VARCHAR(100) NOT NULL,
    waste_type_label VARCHAR(150) NOT NULL,
    title VARCHAR(200) NOT NULL,
    short_description VARCHAR(500),
    recycle_image_url VARCHAR(500) NOT NULL,
    difficulty_level VARCHAR(50),
    estimated_time_minutes INT,
    materials_needed LONGTEXT NOT NULL COMMENT 'Danh sach nguyen lieu can thiet (JSON hoac text)',
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_recycle_suggestions_type_active (waste_type_key, is_active)
);

CREATE TABLE recycle_suggestion_steps (
    step_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    suggestion_id BIGINT NOT NULL,
    step_order INT NOT NULL,
    step_title VARCHAR(200) NOT NULL,
    step_description TEXT NOT NULL,
    instruction_image_url VARCHAR(500) NULL COMMENT 'Hinh anh huong dan cho buoc nay',
    instruction_video_url VARCHAR(500) NULL COMMENT 'Video huong dan (tuy chon)',
    FOREIGN KEY (suggestion_id) REFERENCES recycle_suggestions(suggestion_id) ON DELETE CASCADE,
    UNIQUE KEY uk_recycle_step_order (suggestion_id, step_order)
);

INSERT INTO recycle_suggestions (
    waste_type_key,
    waste_type_label,
    title,
    short_description,
    recycle_image_url,
    difficulty_level,
    estimated_time_minutes,
    materials_needed,
    is_active
) VALUES
('nhua', 'Nhựa', 'Chậu cây mini từ chai nhựa', 'Tận dụng chai nhựa để làm chậu trồng cây để bàn.', 'https://images.unsplash.com/photo-1483794344563-d27a8d18014e', 'Dễ', 25, '["Chai nhua cu","Keo","Keo dan","Dat trong cay","Cay nho","Dinh duc lo"]', TRUE),
('nhua', 'Nhựa', 'Ống đựng bút từ hộp nhựa', 'Tạo ống đựng bút gọn gàng từ hộp nhựa cũ.', 'https://images.unsplash.com/photo-1455390582262-044cdead277a', 'Dễ', 20, '["Hop nhua cung","Giay mau","Keo dan","Keo cat","But marker"]', TRUE),
('giay', 'Giấy', 'Giỏ đựng đồ từ bìa carton', 'Gấp và dán bìa carton thành giỏ lưu trữ đa năng.', 'https://images.unsplash.com/photo-1515879218367-8466d910aaa4', 'Trung bình', 40, '["Bia carton","Keo cat","Keo nen","Giay trang tri","Vai boc ngoai"]', TRUE),
('giay', 'Giấy', 'Khung ảnh handmade từ giấy', 'Làm khung ảnh trang trí từ giấy bìa và giấy màu.', 'https://images.unsplash.com/photo-1510936111840-65e151ad71bb', 'Dễ', 30, '["Giay bia","Giay mau","Keo dan","Keo cat","Sticker","Anh in"]', TRUE),
('kim loai', 'Kim loại', 'Đèn nến từ lon nước', 'Biến lon nước thành đèn nến trang trí an toàn.', 'https://images.unsplash.com/photo-1463320726281-696a485928c7', 'Trung bình', 35, '["Lon nhom","Dao hoac keo","Dinh duc lo","Nen tealight"]', TRUE),
('thuy tinh', 'Thủy tinh', 'Bình hoa từ chai thủy tinh', 'Trang trí chai thủy tinh cũ thành bình hoa.', 'https://images.unsplash.com/photo-1523413651479-597eb2da0ad6', 'Dễ', 30, '["Chai thuy tinh","Son","Day trang tri","Keo cat","Nuoc cam hoa"]', TRUE),
('huu co', 'Rác hữu cơ', 'Phân compost tại nhà', 'Ủ rác hữu cơ thành phân bón cho cây.', 'https://images.unsplash.com/photo-1464226184884-fa280b87c399', 'Trung bình', 120, '["Thung u","Rac huu co","La kho","Phan vi sinh","Dung cu dao"]', TRUE);

